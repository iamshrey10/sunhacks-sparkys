# Copy to .env and fill in YOUR OWN keys. NEVER commit .env.
# Read only by the backend (backend/api/config.py). Never put these in the frontend.

# Gemini (Google AI Studio). Set GEMINI_MODEL to a current model name from the Gemini docs.
GEMINI_API_KEY=
GEMINI_MODEL=

# TinyFish (agent.tinyfish.ai/api-keys)
TINYFISH_API_KEY=

# Optional: extra allowed origins for CORS, comma-separated
CORS_ORIGINS=
